{
  "name": "witch-rpg-v2",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "WitchRPG v2 (Crimson Sovereign: Hutan): action-RPG third-person di hutan terbuka. Ilyra bertarung dengan tongkat dan sihir Chaos, dan membangkitkan musuh yang kalah menjadi pasukan bayangan.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "server": "node --watch server/index.js",
    "start": "node server/index.js",
    "users": "node server/users.js",
    "set-user": "node server/set-user.js",
    "models": "node previz/blender/models.mjs"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
